{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "services_version",
    "services"
  ],
  "properties": {
    "services_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "service_id",
          "name",
          "category",
          "booking_enabled",
          "deliverable_type",
          "evidence_manifest_path"
        ],
        "properties": {
          "service_id": {
            "type": "string",
            "pattern": "^BW-[0-9]{3}$"
          },
          "name": {
            "type": "string",
            "minLength": 2
          },
          "category": {
            "const": "professional_services"
          },
          "booking_enabled": {
            "type": "boolean"
          },
          "deliverable_type": {
            "type": "string",
            "minLength": 2
          },
          "evidence_manifest_path": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
